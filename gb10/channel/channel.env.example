# Copy to channel/channel.env (gitignored by *.env) and fill in one channel.
# CHANNEL is slack, telegram or none. With none, or no channel.env at all, post.py does nothing.
CHANNEL=none
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: dashboard base URL as seen from the reviewer's machine, adds a review link to each package.
DASHBOARD_URL=
